{"uid":"UID22","tag":"ww-text","name":"Review Progress Badge","classes":{"default":["5bb37f8c-d60a-4e3f-b215-101b9f638a90"]},"content":{"default":{"tag":"span","text":{"en":{"__wwtype":"js","code":"// Count how many of this topic's note sections the student has marked reviewed.\nconst topicId = globalContext.pageParameters['topicId'];\nconst notes = globalContext.tableViews['7d4719cb-9d6a-48ce-9a85-4bf524fabe90']?.data || [];\nconst reviewed = variables['439e3f7b-f911-4841-9ef0-612168ab6596'] || {};\nconst ownNotes = notes.filter(function (n) { return n?.topic_id === topicId; });\nif (!ownNotes.length) return 'No sections yet';\nconst doneCount = ownNotes.filter(function (n) { return reviewed[n.id]; }).length;\nreturn doneCount + '/' + ownNotes.length + ' note sections reviewed';","defaultValue":"0 note sections reviewed"}}}},"style":{"default":{"whiteSpace":"nowrap"}}}
{"uid":"UID23","tag":"ww-button","name":"Go To Practice CTA","states":[{"id":"_wwHover","label":"hover"}],"classes":{"default":["239dbe23-213e-4392-8b0d-0429b6e81598"],"_wwHover":["1d5a5b51-d367-487f-996f-3964b96f9444"]},"content":{"default":{"text":{"en":"Go to Practice"},"buttonType":"button","disabled":false}},"link":{"__wwtype":"js","code":"// Send the student to Practice with this topic pre-selected.\nconst topicId = globalContext.pageParameters['topicId'] || '';\nreturn { type: 'internal', pageId: '24b87e3d-6298-463b-9b2d-6dfdf5824a36', targetBlank: false, query: [{ name: 'topicId', value: topicId }] };","defaultValue":{"type":"internal","pageId":"24b87e3d-6298-463b-9b2d-6dfdf5824a36","targetBlank":false}},"style":{"default":{"cursor":"pointer","whiteSpace":"nowrap"}}}
