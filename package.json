{
  "name": "emath-marker",
  "version": "1.0.0",
  "description": "Deterministic math answer marking engine for Singapore O-Level E-Math",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:web": "npm run build --prefix bridging-web",
    "build:vercel": "npm run build && npm run build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx api/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "math",
    "marking",
    "o-level",
    "singapore",
    "assessment"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "mathjs": "^14.4.0",
    "nerdamer": "^1.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vercel/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
