{"uid":"UID19","tag":"ww-text","name":"Topic Notes Title","content":{"default":{"tag":"h1","text":{"en":{"__wwtype":"js","code":"// Resolve the topic from the url parameter so the header names the topic being read.\nconst topicId = globalContext.pageParameters['topicId'];\nconst topics = globalContext.tableViews['2e7e24ea-7339-4bca-954a-24f38b47379d']?.data || [];\nconst topic = topics.find(function (t) { return t?.id === topicId; });\nreturn topic?.name || 'Topic notes';","defaultValue":"Topic notes"}}}},"style":{"default":{"font":"var(--2d7702f0-51f6-41b1-bd66-c7dc5b1395d6, 700 36px/44px 'Inter', sans-serif)","color":"var(--c3f9c15f-d6a5-4463-aad8-1ca500123b9f,#F9FAFB)"},"mobile":{"font":"var(--77b8dd82-d376-43a7-8d22-f19e2cd7a0eb, 600 20px/28px 'Inter', sans-serif)"}}}
{"uid":"UID20","tag":"ww-text","name":"Topic Notes Subtitle","content":{"default":{"tag":"p","text":{"en":{"__wwtype":"js","code":"// Show the syllabus code, subject strand and how many note sections this topic has.\nconst topicId = globalContext.pageParameters['topicId'];\nconst topics = globalContext.tableViews['2e7e24ea-7339-4bca-954a-24f38b47379d']?.data || [];\nconst notes = globalContext.tableViews['7d4719cb-9d6a-48ce-9a85-4bf524fabe90']?.data || [];\nconst topic = topics.find(function (t) { return t?.id === topicId; });\nif (!topic) return 'Choose a topic from the Notes page to start reading.';\nconst sectionCount = notes.filter(function (n) { return n?.topic_id === topicId; }).length;\nconst parts = [];\nif (topic.code) parts.push(String(topic.code).toUpperCase());\nif (topic.category) parts.push(topic.category);\nparts.push(sectionCount + (sectionCount === 1 ? ' note section' : ' note sections'));\nreturn parts.join(' · ');","defaultValue":"Loading topic..."}}}},"style":{"default":{"font":"var(--0c716e13-45b8-41cf-a7f7-b66ac9a6bf9b, 500 13px/18px 'Inter', sans-serif)","color":"var(--18c67ebb-8fca-41e9-b7e2-17c101228283,#9CA3AF)"}}}
